<group name="vaultwarden_rules,">
  <rule id="100200" level="7">
    <decoded_as>vaultwarden-login-failure</decoded_as>
    <if_sid>1002</if_sid>
    <match>vaultwarden::api::identity][ERROR</match>
    <description>Vaultwarden login failure</description>
  </rule>
  
  <rule id="100201" level="3">
    <decoded_as>vaultwarden-login-success</decoded_as>
    <match>vaultwarden::api::identity][INFO</match>
    <description>Vaultwarden login success</description>
  </rule>
  
  <rule id="100202" level="9" frequency="3" timeframe="300">
    <if_matched_sid>100200</if_matched_sid>
    <same_srcip />
    <description>Multiple failed logins to Vaultwarden detected.</description>
  </rule>  
  
  <rule id="100203" level="12" frequency="2" timeframe="3600">
    <if_matched_sid>100202</if_matched_sid>
    <if_sid>100201</if_sid>
    <same_srcip />
    <description>Vaultwarden - Successful and failed auth from same IP.</description>
  </rule>    
</group>

<group name="exclude_rules,">
  <rule id="101020" level="0">
    <if_sid>31101</if_sid>
    <list field="srcip" lookup="address_match_key">etc/lists/private_ranges</list>
    <!--<match>!192.</match>-->
    <description>Ignore web server 400 error codes Private IP</description> 
    <group>attack, web, accesslog</group>
  </rule>
  
  <rule id="101021" level="0">
    <if_sid>5134</if_sid>    
    <match>failures: 0</match>
    <description>Ignore	RNGD failure</description> 
