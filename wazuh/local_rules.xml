<group name="paloalto">
  <rule id="103001" level="7">
    <if_sid>64500</if_sid>
    <field name="event_id" type="pcre2">(?i)^auth-fail</field>
    <description>Palo Alto failed login event.</description>
  </rule>
  <rule id="103002" level="8">
    <if_sid>64502</if_sid>
    <field name="threat_content_type" type="pcre2">(?i)^spyware</field>
    <description>Palo Alto - Blocked domain detected.</description>
  </rule>  
  
  <rule id="103003" level="12" frequency="10" timeframe="300">
    <if_matched_sid>103002</if_matched_sid>
    <same_field>srcip</same_field>
    <description>Multiple blocked domains detected.</description>
  </rule>     

  <rule id="103004" level="12" frequency="5" timeframe="300">
    <if_matched_sid>103001</if_matched_sid>
    <same_field>srcip</same_field>
    <description>Multiple Palo Alto failed login event.</description>
  </rule>   
  
</group>

<group name="local,syslog,sshd,">

  <!--
  Dec 10 01:02:02 host sshd[1234]: Failed none for root from 1.1.1.1 port 1066 ssh2
  -->
  <rule id="100001" level="5">
    <if_sid>5716</if_sid>
    <srcip>1.1.1.1</srcip>
    <description>sshd: authentication failed from IP 1.1.1.1.</description>
    <group>authentication_failed,pci_dss_10.2.4,pci_dss_10.2.5,</group>
  </rule>

</group>


