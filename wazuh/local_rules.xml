<!-- Example -->

<group name="authentik,">
  <rule id="100300" level="3">
    <decoded_as>authentik</decoded_as>
    <description>Authentik event.</description>
  </rule>

  <rule id="100301" level="0">
    <if_sid>100300</if_sid>
    <field name="event" type="pcre2">^.*health\/ready\/</field>
    <description>Authentik health check.</description>
  </rule>  

  <rule id="100302" level="12">
    <if_sid>100300</if_sid>
    <match type="pcre2">^.*login_failed.*</match>
    <description>Authentik failed login event.</description>
  </rule>  
  
  <rule id="100303" level="7">
    <if_sid>100300</if_sid>
    <field name="data.action">login</field>
    <description>Authentik successfull login event.</description>
  </rule>    
  
  <!--<rule id="100371" level="10">-->
  <!--  <if_sid>100300</if_sid>-->
  <!--  <match type="pcre2">^.*Failed to fetch outpost configuration.*</match>-->
  <!--  <description>Authentik outpost errors, authentik could be down.</description>-->
  <!--</rule>      -->
  
  <rule id="100312" level="12" frequency="10" timeframe="300">
    <if_matched_sid>100302</if_matched_sid>
    <same_field>client_ip</same_field>
    <description>Authentik multiple failed login event.</description>
  </rule>    
</group>

<group name="custom-linux">
  
  <rule id="100601" level="12" frequency="4" timeframe="300">
    <if_matched_sid>5715</if_matched_sid>
    <same_srcip />
    <description>Large amount of logins on linux systems from the same srcip.</description>
  </rule>  
  
</group>

